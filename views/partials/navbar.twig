{% set nav_content = landing_content.nav|default({}) %}
{% set app_logo = landing_content.seo.schema.logo|default('assets/img/clinic-mark.svg') %}
{% set app_logo_dark = landing_content.seo.schema.logo_dark|default(app_logo) %}
{% set app_logo_light = landing_content.seo.schema.logo_light|default(app_logo) %}
{% set nav_social_links = [
  {'href': facebook_url|default(''), 'icon': 'facebook', 'label': 'Facebook'},
  {'href': instagram_url|default(''), 'icon': 'instagram', 'label': 'Instagram'},
  {'href': whatsapp_url|default(''), 'icon': 'whatsapp', 'label': 'WhatsApp'}
] %}

<nav class="navbar navbar-expand-lg navbar-dark fixed-top py-3 nav-glass">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-1" href="{{ base_url ?? '/' }}">
      <span class="navbar-logo-wrap" aria-hidden="true">
        <img
          src="{{ base_url ?? '' }}/{{ app_logo_dark }}"
          alt=""
          class="navbar-logo navbar-logo-dark"
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          fetchpriority="low"
        >
        <img
          src="{{ base_url ?? '' }}/{{ app_logo_light }}"
          alt=""
          class="navbar-logo navbar-logo-light"
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          fetchpriority="low"
        >
      </span>
      <span class="brand-name fw-normal">{{ app_name ?? 'Landing de saúde' }}</span>

      <span class="badge rounded-pill text-bg-primary-subtle border border-primary-subtle ms-2 d-none">
        {{ app_badge ?? nav_content.badge|default('Atendimento') }}
      </span>
    </a>

    <div class="d-flex align-items-center nav-mobile-actions ms-auto">
      <button class="navbar-toggler" type="button"
              aria-controls="topNav" aria-expanded="false" aria-label="Abrir menu">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>

    <div class="navbar-collapse nav-mobile-panel" id="topNav" hidden>
      <div class="nav-collapse-inner w-100">
        <ul class="navbar-nav nav-main ms-auto align-items-lg-center gap-lg-2">
        <li class="nav-item nav-priority-1"><a class="nav-link" href="#top">HOME</a></li>
        <li class="nav-item nav-priority-1"><a class="nav-link" href="#badge-vivendo-assim">Escuta</a></li>
        <li class="nav-item nav-priority-1"><a class="nav-link" href="#badge-escolher-se">Se ouvir</a></li>
        <li class="nav-item nav-priority-1"><a class="nav-link" href="#badge-sobre-mim">Sobre mim</a></li>
        <li class="nav-item nav-priority-2"><a class="nav-link" href="#badge-psicoterapia">Psicoterapia</a></li>
        <li class="nav-item nav-priority-2"><a class="nav-link" href="#badge-terapia-casal">Terapia de Casal</a></li>
        <li class="nav-item nav-priority-1">
          <a class="nav-link nav-link-cta" href="{{ whatsapp_url }}" target="_blank" rel="noopener">Agendar</a>
        </li>
        <li class="nav-item nav-priority-1 d-none"><a class="nav-link" href="#features">Serviços</a></li>
        <li class="nav-item nav-priority-2 d-none"><a class="nav-link" href="#how">Atendimento</a></li>
        <li class="nav-item nav-priority-3 d-none"><a class="nav-link" href="#estrutura">Estrutura</a></li>
        <li class="nav-item nav-priority-2 d-none"><a class="nav-link" href="#cta">Agendar (legado)</a></li>
        <li class="nav-item nav-priority-2 d-none"><a class="nav-link" href="#faq">Faq</a></li>
        </ul>

        <div class="nav-actions d-flex align-items-stretch align-items-lg-center gap-2 mt-3 mt-lg-0 ms-lg-3">
          {% if show_palette_selector ?? false %}
          {% set active_palette = palette ?? app_palette ?? 'blue' %}
          {% set palettes = allowed_palettes ?? ['blue', 'red', 'emerald', 'amber', 'violet'] %}
          {% set palette_labels = {
            'blue': 'azul',
            'red': 'vermelha',
            'emerald': 'esmeralda',
            'amber': 'ambar',
            'violet': 'violeta'
          } %}
          <div class="palette-swatches palette-swatches-inline" role="group" aria-label="Selecionar paleta de cores">
            {% for palette_name in palettes %}
            <button
              type="button"
              class="palette-dot palette-dot-{{ palette_name }} {{ active_palette == palette_name ? 'active' : '' }}"
              data-palette-btn="{{ palette_name }}"
              aria-label="Paleta {{ palette_labels[palette_name]|default(palette_name) }}"
              title="{{ palette_name|capitalize }}"
              aria-pressed="{{ active_palette == palette_name ? 'true' : 'false' }}"
            ></button>
            {% endfor %}
          </div>
          {% endif %}

          <nav class="nav-social d-none d-lg-flex align-items-center" aria-label="Redes sociais">
            {% for social in nav_social_links %}
              {% if social.href and social.href != '#' %}
                <a
                  class="nav-social-link"
                  href="{{ social.href }}"
                  {% if social.href starts with 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                  aria-label="{{ social.label }}"
                >
                  <i class="bi bi-{{ social.icon }}"></i>
                </a>
              {% endif %}
            {% endfor %}
          </nav>
        </div>
      </div>
    </div>
  </div>
</nav>
